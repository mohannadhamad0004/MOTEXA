generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  MECHANIC
  PARTS_PROVIDER
  TOW_PROVIDER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum MechanicVerificationStatus {
  DRAFT
  PENDING
  NEEDS_COMPLETION
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  email               String               @unique
  sessionVersion      Int                  @default(0)
  passwordHash        String
  role                UserRole
  status              AccountStatus        @default(PENDING)
  mechanicProfile     MechanicProfile?
  emailVerifiedAt     DateTime?
  mechanicEmailChecks MechanicEmailCheck[]
  notifications       Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetRequests PasswordResetRequest[]
  adminPermissions      AdminPermission[]

  sentInvitations    AdminInvitation[] @relation("InvitationSender")
  acceptedInvitation AdminInvitation?  @relation("InvitationRecipient")

  @@index([role, status])
}

model AdminPermission {
  id         String @id @default(uuid())
  adminId    String
  permission String

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
}

model AdminInvitation {
  id        String @id @default(uuid())
  email     String
  fullName  String
  tokenHash String @unique

  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  permission String

  invitedById String
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id])

  acceptedById String? @unique
  acceptedBy   User?   @relation("InvitationRecipient", fields: [acceptedById], references: [id])

  createdAt  DateTime             @default(now())
  acceptedAt DateTime?
  otps       AdminInvitationOtp[]

  @@index([email, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model MechanicProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  city              String?
  experienceSummary String?
  workshopAddress   String?
  coverageAreas     String[]           @default([])
  termsAcceptedAt   DateTime?
  submittedAt       DateTime?
  submissionVersion Int                @default(0)
  interviewResult   String?
  interviewNotes    String?
  interviewedAt     DateTime?
  interviewedById   String?
  ministryStatus    String             @default("NOT_REQUESTED")
  documents         MechanicDocument[]
  phoneNumber       String?
  nationalId        String?

  nationalIdDocumentUrl String?
  licenseDocumentUrl    String?
  certificateUrl        String?

  yearsOfExperience Int?
  workshopName      String?

  specializations String[]

  offersOnSite   Boolean @default(false)
  offersWorkshop Boolean @default(false)
  offersOnline   Boolean @default(false)

  verificationStatus MechanicVerificationStatus @default(PENDING)

  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

model AdminInvitationOtp {
  id String @id @default(uuid())

  invitationId String
  invitation   AdminInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  codeHash String

  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  createdAt DateTime @default(now())

  @@index([invitationId, createdAt])
}

// Recovery codes are isolated from AdminInvitationOtp.
model PasswordResetRequest {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetTokenHash String?   @unique
  resetExpiresAt DateTime?
  codeHash       String
  expiresAt      DateTime
  sentAt         DateTime?
  verifiedAt     DateTime?
  consumedAt     DateTime?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model MechanicEmailCheck {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model MechanicDocument {
  id         String          @id @default(uuid())
  profileId  String
  profile    MechanicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind       String
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime        @default(now())

  @@unique([profileId, kind])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

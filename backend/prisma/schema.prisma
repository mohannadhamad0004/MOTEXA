
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  MECHANIC
  PARTS_PROVIDER
  TOW_PROVIDER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
}


enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}
enum MechanicVerificationStatus {
  PENDING
  NEEDS_COMPLETION
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  email        String        @unique
  passwordHash String
  role         UserRole
  status       AccountStatus @default(PENDING)
  mechanicProfile MechanicProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminPermissions AdminPermission[]
  mechanicApplication MechanicApplication?
  towCompanyProfile TowCompanyProfile?
  partsShopProfile PartsShopProfile?
  providerFiles ProviderFile[]
  partInquiries PartInquiry[]
  inquiryMessages PartInquiryMessage[]
  towRequests TowRequest[]

  sentInvitations AdminInvitation[] @relation("InvitationSender")
  acceptedInvitation AdminInvitation? @relation("InvitationRecipient")

  @@index([role, status])
}

model AdminPermission {
  id         String @id @default(uuid())
  adminId    String
  permission String

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
}


model AdminInvitation {
  id        String @id @default(uuid())
  email     String
  fullName  String
  tokenHash String @unique

  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
 permission String

  invitedById String
  invitedBy   User @relation("InvitationSender", fields: [invitedById], references: [id])

  acceptedById String? @unique
  acceptedBy   User? @relation("InvitationRecipient", fields: [acceptedById], references: [id])

  createdAt  DateTime @default(now())
  acceptedAt DateTime?

  @@index([email, status])
}


model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}
model MechanicProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber String?
  nationalId  String?

  nationalIdDocumentUrl String?
  licenseDocumentUrl    String?
  certificateUrl        String?

  yearsOfExperience Int?
  workshopName      String?

  specializations String[]

  offersOnSite  Boolean @default(false)
  offersWorkshop Boolean @default(false)
  offersOnline   Boolean @default(false)

  verificationStatus MechanicVerificationStatus @default(PENDING)

  reviewNotes String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

// ---- Mechanic verification application (submitted at signup, reviewed by admins later) ----

enum ReviewItemStatus {
  PENDING
  APPROVED
  REJECTED
}

// Internal review pipeline. AWAITING_AUTHORITY / DECIDED are added by the later authority-verification task.
enum MechanicReviewStatus {
  PENDING_REVIEW
  NEEDS_CORRECTION
  MANUAL_REVIEW
  READY_FOR_AUTHORITY
  REJECTED
}

// An admin's pre-review OBSERVATION. It is never a verdict on authenticity.
enum PreReviewObservation {
  NOT_REVIEWED
  INFORMATION_MATCHES
  MISSING_INFORMATION
  DOCUMENT_UNREADABLE
  EXPIRED
  MANUAL_REVIEW_REQUIRED
}

enum MechanicDocumentKind {
  LICENCE
  CERTIFICATE
}

model MechanicApplication {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone           String
  city            String
  workshopName    String
  workshopAddress String

  licenceNumber     String
  licenceHolderName String
  issuingAuthority  String
  licenceIssueDate  DateTime?
  licenceExpiryDate DateTime?

  authorizationAccepted   Boolean
  authorizationAcceptedAt DateTime

  submittedAt DateTime @default(now())

  reviewStatus MechanicReviewStatus @default(PENDING_REVIEW)
  reviewReason String?

  // Pre-review observations, tracked separately for the person and for the workshop.
  professionalPreReview     PreReviewObservation @default(NOT_REVIEWED)
  professionalPreReviewNote String?
  workshopPreReview         PreReviewObservation @default(NOT_REVIEWED)
  workshopPreReviewNote     String?

  skills   MechanicSkillApplication[]
  documents MechanicDocument[]
}

// One row per claimed skill so each can be approved independently later.
model MechanicSkillApplication {
  id            String              @id @default(uuid())
  applicationId String
  application   MechanicApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  status        ReviewItemStatus    @default(PENDING)
  rejectionReason String?

  @@unique([applicationId, name])
}

// PRIVATE verification files. storageKey is internal and must never be returned by public APIs.
model MechanicDocument {
  id            String               @id @default(uuid())
  applicationId String
  application   MechanicApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          MechanicDocumentKind
  title         String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  createdAt     DateTime             @default(now())
}

// ---- Tow fleet (companies + trucks). Truck photos/documents are a later step. ----

enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TruckVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TruckOperationalStatus {
  AVAILABLE
  BUSY
  OUT_OF_SERVICE
}

enum TruckType {
  FLATBED
  HOOK_CHAIN
  WHEEL_LIFT
  HEAVY_DUTY
}

model TowCompanyProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName   String
  phone         String
  city          String
  address       String?
  licenceNumber String?

  verificationStatus ProviderVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trucks Truck[]
  files  ProviderFile[]
  towRequests TowRequest[]
}

model Truck {
  id        String            @id @default(uuid())
  companyId String
  company   TowCompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plateNumber String    @unique
  make        String
  model       String
  year        Int?
  truckType   TruckType

  verificationStatus TruckVerificationStatus @default(PENDING)
  operationalStatus  TruckOperationalStatus  @default(OUT_OF_SERVICE)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files ProviderFile[]
  towRequests TowRequest[]

  @@index([companyId])
  @@index([verificationStatus])
}

// ---- Parts shops + products. Product images and vehicle fitment are a later step. ----

model PartsShopProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  shopName      String
  phone         String
  city          String
  address       String?
  licenceNumber String?

  verificationStatus ProviderVerificationStatus @default(PENDING)
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products PartsProduct[]
  files    ProviderFile[]
  inquiries PartInquiry[]
}

model PartsProduct {
  id     String           @id @default(uuid())
  shopId String
  shop   PartsShopProfile @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name                 String
  brand                String
  partNumber           String
  partNumberNormalized String
  description          String?
  price                Decimal @db.Decimal(12, 2)
  stock                Int     @default(0)

  // MOTEXA moderation: only admins write these.
  isHidden     Boolean   @default(false)
  hiddenReason String?
  hiddenById   String?
  hiddenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files     ProviderFile[]
  fitments  PartsFitment[]
  inquiries PartInquiry[]

  @@index([shopId])
  @@index([partNumberNormalized])
}

// ---- Provider files (truck photo/documents, product image, company/shop documents) ----
// Bytes live on local disk (backend/storage/provider-files); this table is the only way to reach them.

enum ProviderFilePurpose {
  TRUCK_PHOTO
  TRUCK_REGISTRATION
  TRUCK_INSURANCE
  TOW_COMPANY_DOCUMENT
  PRODUCT_IMAGE
  PARTS_SHOP_DOCUMENT
}

enum ProviderFileVisibility {
  PUBLIC
  PRIVATE
}

model ProviderFile {
  id          String                 @id @default(uuid())
  ownerUserId String
  owner       User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  purpose     ProviderFilePurpose
  visibility  ProviderFileVisibility

  // Exactly one of these is set (enforced by the application).
  truckId      String?
  truck        Truck?             @relation(fields: [truckId], references: [id], onDelete: Cascade)
  towCompanyId String?
  towCompany   TowCompanyProfile? @relation(fields: [towCompanyId], references: [id], onDelete: Cascade)
  productId    String?
  product      PartsProduct?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  partsShopId  String?
  partsShop    PartsShopProfile?  @relation(fields: [partsShopId], references: [id], onDelete: Cascade)

  label        String?
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String    @unique
  sha256       String
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([truckId, purpose])
  @@unique([productId, purpose])
  @@index([ownerUserId])
  @@index([towCompanyId])
  @@index([partsShopId])
}

// ---- Vehicle fitment: which vehicles a part fits. Free text (no make/model catalogue yet). ----

model PartsFitment {
  id        String       @id @default(uuid())
  productId String
  product   PartsProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  make            String
  model           String
  makeNormalized  String // lowercase, trimmed, inner spaces collapsed: used for search
  modelNormalized String
  yearFrom        Int
  yearTo          Int
  trim            String?
  position        Int      @default(0) // keeps the order the form entered
  createdAt       DateTime @default(now())

  @@index([makeNormalized, modelNormalized])
  @@index([productId])
}

// ---- Requests v1: customer questions to parts shops, and tow requests to tow companies ----

enum PartInquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

model PartInquiry {
  id         String @id @default(uuid())
  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shopId     String
  shop       PartsShopProfile @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The inquiry outlives a deleted product: the name and part number are copied at creation.
  productId         String?
  product           PartsProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName       String
  productPartNumber String

  quantity   Int               @default(1)
  status     PartInquiryStatus @default(OPEN)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  messages PartInquiryMessage[]

  @@index([customerId, status])
  @@index([shopId, status])
}

model PartInquiryMessage {
  id        String      @id @default(uuid())
  inquiryId String
  inquiry   PartInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([inquiryId, createdAt])
}

enum TowRequestStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TowCancelledBy {
  CUSTOMER
  COMPANY
}

model TowRequest {
  id         String            @id @default(uuid())
  customerId String
  customer   User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  companyId  String
  company    TowCompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignedTruckId String?
  assignedTruck   Truck?  @relation(fields: [assignedTruckId], references: [id], onDelete: SetNull)
  // Copied at acceptance so history stays readable if the truck is later removed. No plate on purpose.
  assignedTruckType  TruckType?
  assignedTruckMake  String?
  assignedTruckModel String?
  assignedTruckYear  Int?

  pickupAddress  String
  dropoffAddress String
  contactPhone   String // typed by the customer; only the receiving company sees it
  vehicleMake    String
  vehicleModel   String
  vehicleYear    Int?
  notes          String?

  status        TowRequestStatus @default(REQUESTED)
  declineReason String?
  cancelReason  String?
  cancelledBy   TowCancelledBy?

  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?
  declinedAt   DateTime?
  enRouteAt    DateTime?
  inProgressAt DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([customerId, status])
  @@index([companyId, status])
  @@index([assignedTruckId])
}

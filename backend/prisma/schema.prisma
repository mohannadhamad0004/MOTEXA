
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  MECHANIC
  PARTS_PROVIDER
  TOW_PROVIDER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
}


enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}
enum MechanicVerificationStatus {
  PENDING
  NEEDS_COMPLETION
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id           String        @id @default(uuid())
  fullName     String
  email        String        @unique
  passwordHash String
  role         UserRole
  status       AccountStatus @default(PENDING)
  mechanicProfile MechanicProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminPermissions AdminPermission[]
  mechanicApplication MechanicApplication?

  sentInvitations AdminInvitation[] @relation("InvitationSender")
  acceptedInvitation AdminInvitation? @relation("InvitationRecipient")

  @@index([role, status])
}

model AdminPermission {
  id         String @id @default(uuid())
  adminId    String
  permission String

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
}


model AdminInvitation {
  id        String @id @default(uuid())
  email     String
  fullName  String
  tokenHash String @unique

  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
 permission String

  invitedById String
  invitedBy   User @relation("InvitationSender", fields: [invitedById], references: [id])

  acceptedById String? @unique
  acceptedBy   User? @relation("InvitationRecipient", fields: [acceptedById], references: [id])

  createdAt  DateTime @default(now())
  acceptedAt DateTime?

  @@index([email, status])
}


model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}
model MechanicProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber String?
  nationalId  String?

  nationalIdDocumentUrl String?
  licenseDocumentUrl    String?
  certificateUrl        String?

  yearsOfExperience Int?
  workshopName      String?

  specializations String[]

  offersOnSite  Boolean @default(false)
  offersWorkshop Boolean @default(false)
  offersOnline   Boolean @default(false)

  verificationStatus MechanicVerificationStatus @default(PENDING)

  reviewNotes String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

// ---- Mechanic verification application (submitted at signup, reviewed by admins later) ----

enum ReviewItemStatus {
  PENDING
  APPROVED
  REJECTED
}

// Internal review pipeline. AWAITING_AUTHORITY / DECIDED are added by the later authority-verification task.
enum MechanicReviewStatus {
  PENDING_REVIEW
  NEEDS_CORRECTION
  MANUAL_REVIEW
  READY_FOR_AUTHORITY
  REJECTED
}

// An admin's pre-review OBSERVATION. It is never a verdict on authenticity.
enum PreReviewObservation {
  NOT_REVIEWED
  INFORMATION_MATCHES
  MISSING_INFORMATION
  DOCUMENT_UNREADABLE
  EXPIRED
  MANUAL_REVIEW_REQUIRED
}

enum MechanicDocumentKind {
  LICENCE
  CERTIFICATE
}

model MechanicApplication {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone           String
  city            String
  workshopName    String
  workshopAddress String

  licenceNumber     String
  licenceHolderName String
  issuingAuthority  String
  licenceIssueDate  DateTime?
  licenceExpiryDate DateTime?

  authorizationAccepted   Boolean
  authorizationAcceptedAt DateTime

  submittedAt DateTime @default(now())

  reviewStatus MechanicReviewStatus @default(PENDING_REVIEW)
  reviewReason String?

  // Pre-review observations, tracked separately for the person and for the workshop.
  professionalPreReview     PreReviewObservation @default(NOT_REVIEWED)
  professionalPreReviewNote String?
  workshopPreReview         PreReviewObservation @default(NOT_REVIEWED)
  workshopPreReviewNote     String?

  skills   MechanicSkillApplication[]
  documents MechanicDocument[]
}

// One row per claimed skill so each can be approved independently later.
model MechanicSkillApplication {
  id            String              @id @default(uuid())
  applicationId String
  application   MechanicApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  status        ReviewItemStatus    @default(PENDING)
  rejectionReason String?

  @@unique([applicationId, name])
}

// PRIVATE verification files. storageKey is internal and must never be returned by public APIs.
model MechanicDocument {
  id            String               @id @default(uuid())
  applicationId String
  application   MechanicApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          MechanicDocumentKind
  title         String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  createdAt     DateTime             @default(now())
}

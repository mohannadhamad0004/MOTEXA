generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  MECHANIC
  PARTS_PROVIDER
  TOW_PROVIDER
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  REJECTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum MechanicVerificationStatus {
  DRAFT
  PENDING
  NEEDS_COMPLETION
  VERIFIED
  REJECTED
  SUSPENDED
}

model User {
  id                  String               @id @default(uuid())
  phoneNumber         String?
  fullName            String
  email               String               @unique
  sessionVersion      Int                  @default(0)
  passwordHash        String
  role                UserRole
  status              AccountStatus        @default(PENDING)
  vehicles CustomerVehicle[]
  sentServiceRequests ServiceRequest[] @relation("RequestCustomer")
  receivedServiceRequests ServiceRequest[] @relation("RequestMechanic")
  mechanicMessages    MechanicMessage[]
  mechanicProfile     MechanicProfile?
  emailVerifiedAt     DateTime?
  mechanicEmailChecks MechanicEmailCheck[]
  notifications       Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetRequests PasswordResetRequest[]
  adminPermissions      AdminPermission[]

  sentInvitations    AdminInvitation[] @relation("InvitationSender")
  acceptedInvitation AdminInvitation?  @relation("InvitationRecipient")

  @@index([role, status])
}

model AdminPermission {
  id         String @id @default(uuid())
  adminId    String
  permission String

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, permission])
}

model AdminInvitation {
  id        String @id @default(uuid())
  email     String
  fullName  String
  tokenHash String @unique

  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  permission String

  invitedById String
  invitedBy   User   @relation("InvitationSender", fields: [invitedById], references: [id])

  acceptedById String? @unique
  acceptedBy   User?   @relation("InvitationRecipient", fields: [acceptedById], references: [id])

  createdAt  DateTime             @default(now())
  acceptedAt DateTime?
  otps       AdminInvitationOtp[]

  @@index([email, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}

model MechanicProfile {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  city              String?
  experienceSummary String?
  workshopAddress   String?
  workshopLatitude Float?
  workshopLongitude Float?
  coverageAreas     String[]                 @default([])
  termsAcceptedAt   DateTime?
  submittedAt       DateTime?
  submissionVersion Int                      @default(0)
  interviewResult   String?
  interviewNotes    String?
  interviewedAt     DateTime?
  interviewedById   String?
  interviewScheduleId String?
  interviewScheduledAt DateTime?
  interviewMethod String?
  interviewLocation String?
  interviewTimeZone String?
  interviewConfirmedAt DateTime?
  interviewSimulation Boolean @default(false)
  ministryStatus    String                   @default("NOT_REQUESTED")
  tests             MechanicTest[]
  messages          MechanicMessage[]
  documentReviews   MechanicDocumentReview[]
  documents         MechanicDocument[]
  phoneNumber       String?
  nationalId        String?

  nationalIdDocumentUrl String?
  licenseDocumentUrl    String?
  certificateUrl        String?

  yearsOfExperience Int?
  workshopName      String?

  specializations String[]

  offersOnSite   Boolean @default(false)
  offersWorkshop Boolean @default(false)
  offersOnline   Boolean @default(false)

  verificationStatus MechanicVerificationStatus @default(PENDING)

  reviewNotes  String?
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

model AdminInvitationOtp {
  id String @id @default(uuid())

  invitationId String
  invitation   AdminInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  codeHash String

  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  createdAt DateTime @default(now())

  @@index([invitationId, createdAt])
}

// Recovery codes are isolated from AdminInvitationOtp.
model PasswordResetRequest {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resetTokenHash String?   @unique
  resetExpiresAt DateTime?
  codeHash       String
  expiresAt      DateTime
  sentAt         DateTime?
  verifiedAt     DateTime?
  consumedAt     DateTime?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model MechanicEmailCheck {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model MechanicDocument {
  id         String          @id @default(uuid())
  profileId  String
  profile    MechanicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind       String
  fileName   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime        @default(now())

  @@unique([profileId, kind])
}

model Notification {
  relatedUserId String?
  kind          String    @default("APPLICATION")
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  body          String
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
}

model MechanicQuestion {
  code            String?   @unique
  explanation     String    @default("")
  sourceUrl       String    @default("")
  sourceReference String    @default("")
  difficulty      String    @default("INTERMEDIATE")
  reviewStatus    String    @default("DRAFT")
  reviewerName    String?
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  id              String    @id @default(uuid())
  specialization  String
  prompt          String
  options         String[]
  correctIndex    Int
  active          Boolean   @default(false)
  createdById     String
  revision        Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([specialization, active])
}

model MechanicTest {
  id                String             @id @default(uuid())
  profileId         String
  profile           MechanicProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  submissionVersion Int
  attempt           Int
  assignedById      String
  assignedAt        DateTime           @default(now())
  submittedAt       DateTime?
  score             Int?
  reviewedAt        DateTime?
  reviewedById      String?
  assessment        String?
  reviewNotes       String?
  items             MechanicTestItem[]

  @@unique([profileId, submissionVersion, attempt])
  @@index([profileId, assignedAt])
}

model MechanicTestItem {
  id           String       @id @default(uuid())
  testId       String
  test         MechanicTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId   String
  revision     Int
  position     Int
  prompt       String
  options      String[]
  correctIndex Int
  answerIndex  Int?

  @@unique([testId, position])
}

model MechanicMessage {
  id        String          @id @default(uuid())
  profileId String
  profile   MechanicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime        @default(now())

  @@index([profileId, createdAt, id])
}

model MechanicDocumentReview {
  id         String          @id @default(uuid())
  profileId  String
  profile    MechanicProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  documentId String
  storageKey String
  reviewerId String
  reviewedAt DateTime        @default(now())

  @@unique([profileId, documentId])
}

// Partial unique index for ACCEPTED/IN_PROGRESS is defined in migration
// 20261116170000_one_active_service_per_mechanic (SQL predicate).
model ServiceRequest {
  id String @id @default(uuid())
  customerId String
  mechanicId String
  customer User @relation("RequestCustomer", fields:[customerId], references:[id], onDelete:Restrict)
  mechanic User @relation("RequestMechanic", fields:[mechanicId], references:[id], onDelete:Restrict)
  journey WorkshopJourney?
  clientRequestId String
  mode String
  title String
  description String
  vehicle String
  vehicleId String?
  savedVehicle CustomerVehicle? @relation(fields:[vehicleId], references:[id], onDelete:SetNull)
  contactNumber String
  address String @default("")
  status String @default("NEW")
  version Int @default(0)
  decisionNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([customerId,clientRequestId])
  @@index([mechanicId,status,createdAt])
  @@index([customerId,createdAt])
}

model CustomerVehicle {
  photoBytes Bytes?
  photoDigest String?
  photoUpdatedAt DateTime?
  id String @id @default(uuid())
  customerId String
  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)
  clientVehicleId String
  make String
  model String
  year Int
  fuel String
  isActive Boolean @default(false)
  version Int @default(0)
  archivedAt DateTime?
  updatedAt DateTime @default(now()) @updatedAt
  requests ServiceRequest[]
  createdAt DateTime @default(now())
  @@unique([customerId, clientVehicleId])
  @@index([customerId, createdAt])
}

model WorkshopJourney {
 requestId String @id
 request ServiceRequest @relation(fields:[requestId],references:[id],onDelete:Cascade)
 destinationLatitude Float
 destinationLongitude Float
 state String @default("EN_ROUTE")
 sharing Boolean @default(false)
 session String?
 sequence Int @default(0)
 latitude Float?
 longitude Float?
 accuracy Float?
 positionAt DateTime?
 arrivedAt DateTime?
 updatedAt DateTime @updatedAt
}

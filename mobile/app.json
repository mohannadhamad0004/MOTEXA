{
  "expo": {
    "name": "MOTEXA",
    "slug": "motexa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "motexa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.motexa.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9EF",
          "image": "./assets/images/motexa-splash-wordmark.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#30231B",
            "image": "./assets/images/motexa-splash-wordmark-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MOTEXA uses your location while the workshop journey is open. Sharing with your mechanic is optional.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MOTEXA lets you choose a photo of your car to save privately in your garage.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85357c03-0fc1-4f80-8b47-666bb7f4c179"
      }
    }
  }
}
